{"version": 2, "id": "91387715-13d3-4c57-a479-12251842c401", "revision": "1", "name": "Lumen Drift", "intent": "A diffused, slowly modulated reverb starting space. Shape size, decay, damping, predelay and blend through the five native controls.", "role": "fx", "units": [{"id": 0, "module": "reverb", "defaults": [{"unit": 0, "key": "bypassed", "normalized": 0.0}, {"unit": 0, "key": "reverb.size", "normalized": 0.8999999761581420898438}, {"unit": 0, "key": "reverb.decay_seconds", "normalized": 0.1959799081087112426758}, {"unit": 0, "key": "reverb.damping", "normalized": 0.2000000029802322387695}, {"unit": 0, "key": "reverb.predelay_ms", "normalized": 0.0799999982118606567383}, {"unit": 0, "key": "reverb.mix", "normalized": 0.25}], "algorithm_revision": 2}], "panel": {"layout": "orderedFxStrip", "sections": ["Space", "Tone", "Blend"], "controls": [{"label": "Size", "unit": 0, "section": 0, "key": "reverb.size", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 1.0}, {"label": "Decay", "unit": 0, "section": 0, "key": "reverb.decay_seconds", "widget": "rotary", "response": "logarithmic", "minimum": 0.1000000014901161193848, "maximum": 20.0}, {"label": "Predelay", "unit": 0, "section": 0, "key": "reverb.predelay_ms", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 250.0}, {"label": "Damping", "unit": 0, "section": 1, "key": "reverb.damping", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 1.0}, {"label": "Mix", "unit": 0, "section": 2, "key": "reverb.mix", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 1.0}], "surface": "light", "accent": "neutral", "frame": "rounded", "emphasis": "balanced", "spacing": "compact", "density": "sparse"}}