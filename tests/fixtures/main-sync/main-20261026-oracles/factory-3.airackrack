{"version": 2, "id": "91387715-13d3-4c57-a479-12251842d402", "revision": "1", "name": "Anchor Press", "intent": "A linked peak compressor starting point with a measured gentle grip on the untouched Copper Arc voice. Adapt threshold, timing and blend to the actual input; makeup starts at unity.", "role": "fx", "units": [{"id": 0, "module": "compressor", "defaults": [{"unit": 0, "key": "bypassed", "normalized": 0.0}, {"unit": 0, "key": "compressor.threshold_db", "normalized": 0.1624999940395355224609}, {"unit": 0, "key": "compressor.ratio", "normalized": 0.1052631586790084838867}, {"unit": 0, "key": "compressor.attack_ms", "normalized": 0.1491491496562957763672}, {"unit": 0, "key": "compressor.release_ms", "normalized": 0.0703517571091651916504}, {"unit": 0, "key": "compressor.makeup_db", "normalized": 0.0}, {"unit": 0, "key": "compressor.mix", "normalized": 1.0}], "algorithm_revision": 2}], "panel": {"layout": "orderedFxStrip", "sections": ["Grip", "Timing", "Blend"], "controls": [{"label": "Threshold", "unit": 0, "section": 0, "key": "compressor.threshold_db", "widget": "rotary", "response": "linear", "minimum": -60.0, "maximum": 0.0}, {"label": "Ratio", "unit": 0, "section": 0, "key": "compressor.ratio", "widget": "rotary", "response": "linear", "minimum": 1.0, "maximum": 20.0}, {"label": "Attack", "unit": 0, "section": 1, "key": "compressor.attack_ms", "widget": "rotary", "response": "logarithmic", "minimum": 0.1000000014901161193848, "maximum": 100.0}, {"label": "Release", "unit": 0, "section": 1, "key": "compressor.release_ms", "widget": "rotary", "response": "logarithmic", "minimum": 10.0, "maximum": 2000.0}, {"label": "Makeup", "unit": 0, "section": 2, "key": "compressor.makeup_db", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 24.0}, {"label": "Mix", "unit": 0, "section": 2, "key": "compressor.mix", "widget": "rotary", "response": "linear", "minimum": 0.0, "maximum": 1.0}], "surface": "light", "accent": "neutral", "frame": "rounded", "e