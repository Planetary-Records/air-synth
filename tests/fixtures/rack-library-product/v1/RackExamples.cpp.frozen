RackDesign tileArrayRackDesign(){
 RackDesign tile;
 tile.id=juce::Uuid("f97641c2-cd64-46a9-a3ab-0cc027a5f8d4");
 tile.name="Tile Array";
 tile.intent="A sixteen-pad one-shot drum instrument. Import an isolated hit or request three local candidates for one pad, audition and keep one without disturbing its neighbours. Trim, tune, shape the attack and decay, assign notes and choke groups. Kit level and pan stay immediately available; source generation is optional and saved kits play offline.";
 tile.role=RackRole::synth;
 tile.units={{0,NativeModule::drum,{}}};
 auto& unit=tile.units[0];
 value(unit,"enabled",1);value(unit,"level",.5f);value(unit,"pan",0);
 for(int pad=0;pad<16;++pad){
  const auto key="drum.pad."+juce::String(pad+1)+".";
  value(unit,key+"gain_db",0);value(unit,key+"pan",0);value(unit,key+"tune_semitones",0);
  value(unit,key+"trim_start",0);value(unit,key+"trim_end",1);
  value(unit,key+"attack_seconds",0);value(unit,key+"decay_seconds",0);
  value(unit,key+"midi_note",float(36+pad));value(unit,key+"choke_group",0);
 }
 tile.panel.layout=PanelLayout::performanceControls;tile.panel.sections={"KIT"};
 tile.panel.controls={focus("KIT LEVEL",0,0,"level",FocusWidget::verticalSlider,0,1),focus("KIT PAN",0,0,"pan",FocusWidget::rotary,-1,1)};
 return tile;
}
