std::vector<RackDesign> libraryRackDesigns(){
 const auto examples=exampleRackDesigns();std::vector<RackDesign> result(examples.begin(),examples.end());
 for(auto& f:factoryRackDesigns())result.push_back(std::move(f));
 result.push_back(tileArrayRackDesign());
 return result;
}
