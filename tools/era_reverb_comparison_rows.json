{
  "about": "Era Reverb against ValhallaVintageVerb, one row per behaviour in docs/superpowers/specs/2026-10-22-era-reverb-design.md. RackSynthRender --era-reverb renders each source dry and each row processed through the actual VST3; tools/era_reverb_comparison.py feeds the same dry source through VintageVerb and measures both. Gate rows run Era at Decay 0.2 s, as its DSP contract does: there Decay sets the close (0.1 x Decay) after the burst, while VintageVerb's Nonlin ignores Decay. Development evidence, not a parity claim.",
  "rate": 48000,
  "block": 512,
  "neutral": {
    "voicing": 0, "age": 2, "decay_seconds": 2, "predelay_ms": 0, "size": 1, "attack": 0.5, "diffusion": 1,
    "wobble": 0, "wobble_rate_hz": 2.53, "grit": 0, "bass_multiplier": 1, "damping_hz": 20000,
    "low_cut_hz": 10, "high_cut_hz": 20000, "mix": 1
  },
  "vintageverb_neutral": {
    "mix": 100, "predelay": 0, "decay": 2.0, "size": 100, "attack": 50, "bassmult": 1.0, "bassxover": 300,
    "highshelf": 0, "highfreq": 6000, "earlydiffusion": 100, "latediffusion": 100, "modrate": 2.53, "moddepth": 0,
    "highcut": 20000, "lowcut": 10
  },
  "sources": {
    "click": "Noise click: the analog voice's noise alone, 3 ms decay, filter open",
    "burst": "Noise burst held 50 ms, filter open",
    "sine220": "220 Hz sine (MIDI 57) held 2 s, peak calibrated to -6 dBFS",
    "sine220_quiet": "The same 220 Hz sine, peak calibrated to -36 dBFS",
    "sine1k": "1 kHz sine (MIDI 83 plus 21.31 cents) held 2 s, peak calibrated to -12 dBFS"
