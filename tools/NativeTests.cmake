# Keep the original test commands and arguments; coordinate only their external resources.
include("${CMAKE_CURRENT_LIST_DIR}/NativeTestLimits.cmake")
if(WIN32)
    add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/native-run" "${CMAKE_BINARY_DIR}/tools/native-run")
endif()

function(racksynth_add_test)
    cmake_parse_arguments(PARSE_ARGV 0 test "EXCLUSIVE" "NAME" "COMMAND")
    if(test_UNPARSED_ARGUMENTS OR NOT test_NAME OR NOT test_COMMAND)
        message(FATAL_ERROR "Expected racksynth_add_test(NAME name [EXCLUSIVE] COMMAND program args...)")
    endif()
    if(WIN32)
        list(POP_FRONT test_COMMAND program)
        if(TARGET "${program}")
            add_dependencies("${program}" RackSynthNativeRun)
            set(program "$<TARGET_FILE:${program}>")
        endif()
        set(lease)
        if(test_EXCLUSIVE)
            list(APPEND lease --exclusive)
        endif()
        racksynth_test_run_seconds("${test_NAME}" run_seconds)
        add_test(NAME "${test_NAME}" COMMAND RackSynthNativeRun ${lease} --run-seconds ${run_seconds} -- "${program}" ${test_COMMAND})
    else()
        add_test(NAME "${test_NAME}" COMMAND ${test_COMMAND})
    endif()
    set_property(TEST "${test_NAME}" PROPERTY RACKSYNTH_COORDINATED TRUE)
    if(test_EXCLUSIVE)
        set_tests_properties("${test_NAME}" PROPERTIES RACKSYNTH_TIMING TRUE COST 10000)
        set_property(TEST "${test_NAME}" APPEND PROPERTY LABELS timing)
        if(NOT WIN32)
            set_property(TEST "${test_NAME}" PROPERTY RUN_SERIAL TRUE)
        endif()
    endif()
endfunction()

function(racksynth_order_timing_tests)
    set(timing)
    foreach(test IN LISTS ARGN)
        get_test_property(${test} RACKSYNTH_TIMING measured)
        if(measured)
            list(APPEND timing ${test})
        endif()
    endforeach()
    foreach(test IN LISTS ARGN)
        if(timing AND NOT test IN_LIST timing)
            # Queue timing leases together before functional work; each launcher still owns its own lease.
            set_property(TEST ${test} APPEND PROPERTY DEPENDS ${timing})
        endif()
    endforeach()
endfunction()

function(racksynth_private_desktops)
    foreach(test IN LISTS ARGN)
        get_test_property(${test} RESOURCE_LOCK resources)
        if("desktop" IN_LIST resources)
            set_property(TEST ${test} APPEND PROPERTY LABELS desktop)
            if(WIN32)
                set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "AIRACK_NATIVE_PRIVATE_DESKTOP=1")
                list(REMOVE_ITEM resources desktop)
                set_property(TEST ${test} PROPERTY RESOURCE_LOCK "${resources}")
                # Keep the local eight-slot bound; CI's resource file independently caps GUI commands at four.
                set_property(TEST ${test} PROPERTY PROCESSORS 2)
                set_property(TEST ${test} APPEND PROPERTY RESOURCE_GROUPS "gui:1")
            endif()
        endif()
    endforeach()
endfunction()
